    projects.forEach((project) => {
        project.addEventListener("mouseenter", () => {
            const mediaItems = projectMedia[project.dataset.project] ?? [];
            const image = mediaItems.find((item) => item.type === "image");
            const youtube = mediaItems.find((item) => item.type === "youtube");

            const src =
                image?.src ??
                (youtube
                    ? `https://img.youtube.com/vi/${youtube.id}/hqdefault.jpg`
                    : "");

            if (!src || !preview || !previewImage) return;

            previewImage.src = src;
            previewImage.alt = `${project.querySelector("h2")?.textContent?.trim() ?? "Project"} preview`;

            preview.classList.remove("hidden");
            requestAnimationFrame(() => {
                preview.classList.remove("opacity-0");
            });
        });
    });

    projectList?.addEventListener("mousemove", (event) => {
        if (!preview || preview.classList.contains("hidden")) return;

        const x = Math.min(event.clientX + 20, window.innerWidth - 410);
        const y = Math.min(event.clientY + 20, window.innerHeight - 190);

        preview.style.left = `${Math.max(12, x)}px`;
        preview.style.top = `${Math.max(12, y)}px`;
    });

    projectList?.addEventListener("mouseleave", () => {
        if (!preview) return;

        preview.classList.add("opacity-0");
        setTimeout(() => preview.classList.add("hidden"), 200);
    });

    projects.forEach((project) => {
        project.addEventListener("click", () => {
            const title = project.querySelector("h2")?.textContent?.trim();

            if (preview) {
                preview.classList.add("hidden", "opacity-0");
            }

            const description =
                project.dataset.description ||
                project.querySelector("p")?.textContent?.trim() ||
                "";

            const titleElement = modalContent?.querySelector(
                "#modal-project-title",
            );
            const descriptionElement = modalContent?.querySelector(
                "#modal-project-description",
            );

            if (titleElement && title) {
                titleElement.textContent = title;
            }

            if (descriptionElement) {
                descriptionElement.textContent = description;
            }

            // Clear previous media.
            if (mediaContainer) {
                mediaContainer.replaceChildren();

                const mediaItems = projectMedia[project.dataset.project] ?? [];

                mediaItems.forEach((item, index) => {
                    // Display images.
                    if (item.type === "image") {
                        const img = document.createElement("img");
                        img.src = item.src;
                        img.alt = `${title ?? "Project"} - Image ${index + 1}`;
                        img.className = "h-auto w-full";
                        img.loading = "lazy";

                        mediaContainer.appendChild(img);
                        return;
                    }

                    // Display videos.
                    const wrapper = document.createElement("div");
                    wrapper.className = "aspect-video w-full";

                    const iframe = document.createElement("iframe");

                    if (item.type === "youtube") {
                        iframe.src = `https://www.youtube.com/embed/${item.id}`;
                    } else if (item.type === "vimeo") {
                        iframe.src = `https://player.vimeo.com/video/${item.id}`;
                    } else {
                        return;
                    }

                    iframe.title = `${title ?? "Project"} - Video ${index + 1}`;
                    iframe.className = "h-full w-full";
                    iframe.loading = "lazy";
                    iframe.allow = "autoplay; fullscreen; picture-in-picture";
                    iframe.referrerPolicy = "strict-origin-when-cross-origin";
                    iframe.allowFullscreen = true;

                    wrapper.appendChild(iframe);
                    mediaContainer.appendChild(wrapper);
                });
            }

            modal?.classList.remove("hidden");
            modal?.classList.add("flex");

            requestAnimationFrame(() => {
                modal?.classList.remove("opacity-0", "bg-black/0");
                modal?.classList.add("opacity-100", "bg-black/80");
            });

            document.body.style.overflow = "hidden";
        });
    });

    function closeModal() {
        modal?.classList.remove("opacity-100", "bg-black/80");
        modal?.classList.add("opacity-0", "bg-black/0");

        // Remove videos and images when closing.
        if (mediaContainer) {
            mediaContainer.replaceChildren();
        }

        document.body.style.overflow = "";

        setTimeout(() => {
            modal?.classList.add("hidden");
            modal?.classList.remove("flex");
        }, 300);
    }

    closeButton?.addEventListener("click", closeModal);

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modal?.classList.contains("hidden")) {
            closeModal();
        }
    });

    modal?.addEventListener("click", (event) => {
        if (event.target === modal) {
            closeModal();
        }
    });
</script>
