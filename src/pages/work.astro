---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import ProjectModal from "../components/ProjectModal.astro";
---

<Layout>
    <Header />

    <main class="min-h-screen bg-zinc-950 text-zinc-50">
        <div
            id="project-preview"
            class="pointer-events-none fixed left-0 top-0 z-40 hidden w-[24.3rem] opacity-0 transition-opacity duration-200"
        >
            <img
                id="project-preview-image"
                src=""
                alt=""
                class="aspect-video w-full object-cover"
            />
        </div>
        <section class="mx-auto w-[calc(100%-48px)] max-w-[1100px] pt-16 pb-12">
            <!-- Work filters -->
            <div class="flex gap-4 border-b border-zinc-800 pb-3">
                <span class="titles-mono text-sm text-accent">All Work</span>
                <!-- <span class="titles-mono text-sm text-muted">
                    Selected Work
                </span> -->
            </div>

            <!-- Project list -->
            <div>
                <!-- google flow -->
                <article
                    data-project="google-flow"
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">Google Flow Ads</h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        Showcasing the capabilities of Google's Flow through a
                        series of videos highlighting its most important
                        features and latest updates.
                    </p>
                </article>
                <!-- batman -->
                <article
                    data-project="batman"
                    data-description="Batman Sagas is a cinematic promotional piece created for Cinemax, merging the distinct visions of Tim Burton and Christopher Nolan through carefully edited sequences from their iconic Batman films. Enhanced with glitch effects and custom handcrafted typography, the project creates an immersive visual experience that celebrates the Dark Knight’s cinematic legacy. Its creative impact was recognized with two Promax Latin America awards and one Clio Award."
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">Batman Sagas</h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        Intricately merges the cinematic worlds of Tim Burton
                        and Christopher Nolan, showcasing their distinct visions
                        of the iconic Dark Knight.
                    </p>
                </article>
                <!-- kubrick -->
                <article
                    data-project="kubrick"
                    data-description="To recreate some of the most important scenes in the movies of Stanley Kubrick is not an easy task, but with a little use of creativity and simplification it is possible to make a proposal that encompasses the more iconic scenes.

                    Make with blender, composed in After Effects, and sound mixed and compose with Soundbridge."
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">Kubrick Screenings</h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        A creative, simplified recreation of Stanley Kubrick's
                        most iconic movie scenes.
                    </p>
                </article>
                <!-- universal -->
                <article
                    data-project="universal"
                    data-description="A dynamic 2D motion graphics promo created for Universal Channel, bringing together Chicago Med, Chicago P.D., and Chicago Fire through an immersive 2D projection developed in After Effects. The piece blends captivating visuals and fluid animation to connect the three series, capturing the intensity of Chicago’s medical professionals and first responders as they face the challenges of saving lives and protecting the city."
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">Universal Chicago</h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        Dive into the heartbeat of Chicago with the latest 2D
                        motion graphic promo for Universal Channel's gripping
                        medical drama series.
                    </p>
                </article>
                <!-- christmas -->
                <article
                    data-project="christmas"
                    data-description="Embark on a dazzling journey through the world of E Entertainment's 3D video production tailored for Latin America and Brazil, where the magic of the holiday season collides with the glamour of the network's most famous shows. Step into a larger-than-life advent calendar that unfolds into a mesmerizing spectacle, each compartment revealing snippets and highlights from E's iconic programs. From the red carpet allure of celebrity events to the juicy drama of reality TV, every video encapsulates the essence of E Entertainment's most beloved shows, transporting viewers into the heart of entertainment culture."
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">Christmas E!</h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        Embark on a dazzling journey through the world of E
                        Entertainment's 3D video production tailored for Latin
                        America and Brazil, where the magic of the holiday
                        season collides with the glamour of the network's most
                        famous shows.
                    </p>
                </article>
                <!-- planetarium -->
                <article
                    data-project="planetarium"
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">
                        Interactive Experience_Humboldt Planetarium
                    </h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        Bringing the Humboldt Planetarium to Life Through
                        Interactive Media.
                    </p>
                </article>
                <!-- opticalia -->
                <article
                    data-project="opticalia"
                    data-description="Step into the captivating world of eyewear through my 3D animated video series created for Opticalia. These visually stunning animations showcase a myriad of glasses mounts, each meticulously crafted to highlight unique features and styles. From contemporary designs to timeless classics, these videos not only promote Opticalia's diverse eyewear range but also underscore my expertise as a skilled 3D artist. Experience the fusion of artistry and technology in every frame, making this series an engaging testament to the precision and creativity I bring to the world of 3D animation."
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">Opticalia Art 3D</h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        Step into the captivating world of eyewear through my 3D
                        animated video series created for Opticalia. These
                        visually stunning animations showcase a myriad of
                        glasses mounts, each meticulously crafted to highlight
                        unique features and styles.
                    </p>
                </article>
                <!-- toro                -->
                <article
                    data-project="toro"
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">
                        Guillermo del Toro Birthday Tribute Promo
                    </h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        Created a birthday tribute promo for Cinemax celebrating
                        Guillermo del Toro by recreating iconic scenes from his
                        films using 2D and 3D techniques.
                    </p>
                </article>
                <!-- minds -->
                <article
                    data-project="minds"
                    data-description="AXN · 2013 · Promax Latin America, Bronze Winner

                    Promotional piece for Criminal Minds, built around the concept “Words can be lethal weapons.” The project explores the dark psychology of the series through hundreds of animated letters that transform into weapons, representing the destructive power of words.

                    My role covered design, rigging, dynamics, texturing, lighting, animation, and compositing. Using Cinema 4D, I developed complex simulations with hundreds of interacting elements, optimizing dynamics and rendering workflows to meet tight deadlines. Final compositing was completed in After Effects.

                    Credits: Original concept and production by Marisabel Torres. Design, animation, and compositing by Wilfred Hernández. Audio mastering and mixing by Valentina Duran."
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">Words as Weapons</h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        A dark, cinematic promo for Criminal Minds, transforming
                        hundreds of animated letters into weapons to explore the
                        destructive power of words. Created with Cinema 4D and
                        After Effects, the project won Bronze at Promax Latin
                        America.
                    </p>
                </article>
                <!-- compositing -->
                <article
                    data-project="compositing"
                    data-description="Project Breakdown · In Order of Appearance

                    Transformers Combiners: Firefly
                    Cloud simulation / Smoke and dust simulation / Pass compositing / Color grading

                    Avengers: Captain America
                    Bike smoke simulation / Compositing / Color grading

                    Transformers Combiners: Superion
                    Background design / Smoke and dust compositing / Pass compositing

                    Transformers JD China
                    Full compositing / Particle animation / Color grading

                    Stereopicnic Bogotá 2016
                    Pass compositing / Smoke simulation

                    Transformers: Robots in Disguise
                    Full compositing / 2D conversion from 3D / Particle animation

                    Hasbro: Play Big
                    Pass compositing / Color grading / Motion blur / Graphic elements

                    Hasbro: Magic Box
                    Full compositing / Smoke simulation

                    Transformers Combiners: Menasor
                    Background design and matte painting / Smoke and dust simulation / Pass compositing / Glass shatter simulation / Tracking

                    Top Gear: Month Races Special
                    Full content production

                    BBC Earth Contest
                    Full content production

                    Nerf
                    3D door intro

                    Transformers Combiners: Firefly
                    Cloud simulation / Smoke and dust simulation / Pass compositing / Color grading

                    Aromatel
                    Compositing / Color grading / Displacement effects on typography

                    Play-Doh: Back to School
                    All production except the monkey and dinosaur

                    Transformers JD China
                    Full compositing / Color grading

                    Monopoly LATAM Challenge
                    3D camera animation / Compositing

                    Transformers Combiners: Defensor
                    Background design / Smoke, dust, and jetpack fire simulations / Pass compositing / Masking and rotoscoping / 2D effects

                    Transformers Combiners: Defensor
                    Background design / 3D layout and prop and scene modeling / Optical flares / Pass compositing / Masking and rotoscoping

                    Playskool Heroes
                    Pass compositing / Tracking and masking / Base color"
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">Compositing Works</h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        An exploration into fluids, light and textures.
                    </p>
                </article>
                <!-- murder -->
                <article
                    data-project="murder"
                    data-description="How to Get Away with Murder - Especial Karla Souza - Graphic Package

                    This spot is property of Sony Pictures Entertainment Networks. For evaluation purposes only.

                    How to Get Away with Murder - Especial Karla Souza - Graphic Package
                    Audio Mixing - Antonio Mosqueda.
                    Video Editing - Arturo Duran.
                    Producer - Esther Gómez.
                    Art Director - Andrea García.
                    Graphic Coordinator - Wilfred Hernandez.
                    Graphic Coordinator - Elisa Ruiz.
                    Regional Art Director - Sergio Moreno.
                    Visual Concept - Marco Urdaneta.
                    3D Concept & Intro Design - Roberto Carbonell.
                    3D Animation & Lighting - Carlos Dordelly.
                    Compositing - Andrea di Berardino and Carlos Dordelly.
                    2D Animation & Lowbars Design - Andrea di Berardino."
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">
                        How to Get Away With Murder - Especial Karla Souza
                    </h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        How to Get Away with Murder - Especial Karla Souza -
                        Graphic Package
                    </p>
                </article>
                <!-- oasis -->
                <article
                    data-project="oasis"
                    class="cursor-pointer border-b border-zinc-800 py-5"
                >
                    <h2 class="text-base font-bold">Oasis Blend</h2>
                    <p class="mt-1 text-sm leading-5 text-muted">
                        Product animation for Oasis Blend energy drink.
                    </p>
                </article>
            </div>

            <!-- Back to home -->
            <div class="pt-6">
                <a
                    href="/"
                    class="titles-mono text-sm text-accent hover:underline"
                >
                    &lt; Back to Home
                </a>
            </div>
        </section>
    </main>

    <ProjectModal />
    <Footer />
</Layout>

<script>
