---
// src/pages/index.astro
import Layout from "../layouts/Layout.astro";
---

<Layout title="start_My portfolio">
    <main class="text-center max-w-xl my-24 flex flex-col justify-center items-center">
        <h1 class="text-4xl md:text-6xl font-black tracking-tight mb-4">
            Hi, My name is Roberto Carbonell
        </h1>
        <p class="subheadline mb-8">
            I'm a Motion Designer and Creative Web Developer
        </p>
        <div>
            <a
                href="/projects"
                class="inline-block bg-amber-500 text-zinc-950 font-bold px-6 py-3 rounded-full hover:bg-amber-400 transition duration-150 hover:scale-105"
            >
                Watch projects!
            </a>
        </div>
    </main>
</Layout>
