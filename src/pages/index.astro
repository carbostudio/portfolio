    const projectPreviews = {
        "google-flow": "https://img.youtube.com/vi/qr7c4TJrVWY/hqdefault.jpg",
        batman: "/images/projects/batman/4d63ef185296015.6560fe9a769f4.webp",
        kubrick: "/images/projects/kubrick/1bbb74147730225.62c79b2256a4f.png",
        universal:
            "/images/projects/universal/4eea85185298751.65610b021d660.webp",
        christmas:
            "/images/projects/christmas/1d2af6185333257.6561edeed4a6c.webp",
        planetarium:
            "/images/projects/planetarium/4d96dd39767665.5606c0fb1e0a5.webp",
    };

    // Floating preview follows the pointer over the project list.
    projects?.forEach((project) => {
        project.addEventListener("mouseenter", () => {
            const src = projectPreviews[project.dataset.project];

            if (!src || !preview || !previewImage) return;

            previewImage.src = src;
            previewImage.alt = `${project.querySelector("h3")?.textContent?.trim() ?? "Project"} preview`;

            preview.classList.remove("hidden");

            requestAnimationFrame(() => {
                preview.classList.remove("opacity-0");
            });
        });
    });

    projectList?.addEventListener("mousemove", (event) => {
        if (!preview || preview.classList.contains("hidden")) return;

        const x = Math.max(
            12,
            Math.min(event.clientX + 20, window.innerWidth - 300),
        );

        const y = Math.max(
            12,
            Math.min(event.clientY + 20, window.innerHeight - 190),
        );

        preview.style.left = `${x}px`;
        preview.style.top = `${y}px`;
    });

    projectList?.addEventListener("mouseleave", () => {
        if (!preview) return;

        preview.classList.add("opacity-0");

        setTimeout(() => {
            preview.classList.add("hidden");
        }, 200);
    });

    // Open the shared project modal when a project is clicked.
    projects?.forEach((project) => {
        project.addEventListener("click", () => {
            const title = project.querySelector("h3")?.textContent?.trim();
            const description =
                project.querySelector("p")?.textContent?.trim() ?? "";

            if (!modal || !mediaContainer) return;

            if (preview) {
                preview.classList.add("hidden", "opacity-0");
            }

            const titleElement = modalContent?.querySelector(
                "#modal-project-title",
            );
            const descriptionElement = modalContent?.querySelector(
                "#modal-project-description",
            );

            if (titleElement && title) {
                titleElement.textContent = title;
            }

            if (descriptionElement) {
                descriptionElement.textContent = description;
            }

            mediaContainer.replaceChildren();

            const mediaItems = projectMedia[project.dataset.project] ?? [];

            mediaItems.forEach((item, index) => {
                if (item.type === "image") {
                    const img = document.createElement("img");
                    img.src = item.src;
                    img.alt = `${title ?? "Project"} - Image ${index + 1}`;
                    img.className = "h-auto w-full";
                    img.loading = "lazy";
                    mediaContainer.appendChild(img);
                    return;
                }

                const wrapper = document.createElement("div");
                wrapper.className = "aspect-video w-full";

                const iframe = document.createElement("iframe");

                if (item.type === "youtube") {
                    iframe.src = `https://www.youtube.com/embed/${item.id}`;
                } else if (item.type === "vimeo") {
                    iframe.src = `https://player.vimeo.com/video/${item.id}`;
                } else {
                    return;
                }

                iframe.title = `${title ?? "Project"} - Video ${index + 1}`;
                iframe.className = "h-full w-full";
                iframe.loading = "lazy";
                iframe.allow = "autoplay; fullscreen; picture-in-picture";
                iframe.referrerPolicy = "strict-origin-when-cross-origin";
                iframe.allowFullscreen = true;

                wrapper.appendChild(iframe);
                mediaContainer.appendChild(wrapper);
            });

            modal.classList.remove("hidden");
            modal.classList.add("flex");

            requestAnimationFrame(() => {
                modal.classList.remove("opacity-0", "bg-black/0");
                modal.classList.add("opacity-100", "bg-black/80");
            });

            document.body.style.overflow = "hidden";
        });
    });

    function closeModal() {
        modal?.classList.remove("opacity-100", "bg-black/80");
        modal?.classList.add("opacity-0", "bg-black/0");

        if (mediaContainer) {
            mediaContainer.replaceChildren();
        }

        document.body.style.overflow = "";

        setTimeout(() => {
            modal?.classList.add("hidden");
            modal?.classList.remove("flex");
        }, 300);
    }

    closeButton?.addEventListener("click", closeModal);

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !modal?.classList.contains("hidden")) {
            closeModal();
        }
    });

    modal?.addEventListener("click", (event) => {
        if (event.target === modal) {
            closeModal();
        }
    });
</script>
