---
---

<div
    id="project-modal"
    class="fixed inset-0 z-50 hidden items-start justify-center overflow-y-auto bg-black/0 p-4 opacity-0 transition-opacity duration-300 ease-out min-[700px]:p-8"
>
    <div class="relative my-auto w-full max-w-[900px] bg-zinc-900 px-5 py-8 min-[700px]:px-12 min-[700px]:py-10">
        <!-- Close button -->
        <button
            id="close-project-modal"
            type="button"
            aria-label="Close project"
            class="absolute right-4 top-4 text-2xl text-muted transition-colors hover:text-light"
        >
            &times;
        </button>

        <!-- Project content -->
        <div id="project-modal-content" class="pt-4">
            <!-- Project title -->
            <h2 id="modal-project-title" class="text-2xl font-bold text-accent">
                Project title
            </h2>

            <!-- Project description -->
            <p
                id="modal-project-description"
                class="mt-3 text-sm leading-6 text-muted"
            >
                Project description will appear here.
            </p>

            <!-- Project media -->
            <div
                id="modal-project-media"
                class="mt-8 flex flex-col gap-6"
            ></div>
        </div>
    </div>
</div>
